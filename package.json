{
  "name": "tea-design",
  "version": "1.0.0",
  "description": "Tea Design - Mobile First Responsive Website",
  "scripts": {
    "audit": "pnpm audit --audit-level high",
    "start": "webpack serve --mode development --open",
    "build": "webpack --mode production",
    "check": "pnpm biome:check && pnpm build",
    "security": "pnpm audit --audit-level high",
    "watch": "webpack --watch --mode development",
    "biome:check": "biome check .",
    "biome:fix": "biome check . --write",
    "biome:format": "biome format . --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@testing-library/react": "16.3.3",
    "vitest": "4.1.11",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "6.0.0"
  },
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "pnpm": {
    "overrides": {
      "webpack": ">=5.104.1 <6",
      "serialize-javascript": ">=7.0.5 <8",
      "webpack-dev-server": ">=5.2.1 <7",
      "vite": "8.3.1",
      "nanoid": "3.3.19",
      "shell-quote": ">=1.11.0 <2",
      "uuid": ">=12.0.1 <13",
      "qs": ">=6.16.0 <7",
      "webpack-dev-middleware": ">=8.3.0 <9",
      "fast-uri": ">=3.1.8 <4",
      "proxy-addr": ">=2.0.8 <3",
      "source-map-js": ">=1.2.2 <2",
      "compression": ">=1.8.2 <2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
